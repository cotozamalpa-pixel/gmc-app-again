# PostgreSQL connection string (Neon, Supabase, Railway, or self-hosted)
DATABASE_URL="postgresql://user:password@host:5432/muzenza?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# QR code signing secret (used to sign daily attendance tokens so they can't be forged)
QR_SIGNING_SECRET="generate-a-long-random-string"

# Default admin account created by the seed script
SEED_ADMIN_EMAIL="admin@muzenzapolska.pl"
SEED_ADMIN_PASSWORD="ChangeMe123!"
